# Copy to .env and fill real values. Never commit .env.

PORT=3000
NODE_ENV=development

# Required in production
JWT_SECRET=replace-with-long-random-secret

DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/codearena?schema=public
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3003
ALLOW_DEV_SOCIAL_AUTH=true
SANDBOX_MODE=process
TRUST_PROXY=false

# --- Cloud Object Storage (S3 / Cloudflare R2 / GCS) ---
# AWS_S3_BUCKET=codearena-assets
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Live Generative AI Engine (OpenAI / Gemini / Anthropic) ---
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# --- Hardened Sandbox (Docker / Container Isolation) ---
# DOCKER_SANDBOX=true
# STRICT_SANDBOX=true
