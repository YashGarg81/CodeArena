# ─────────────────────────────────────────────────────────────
# CodeArena — Environment Configuration Template
# Copy this file to .env (or backend/.env) and fill real values.
# ⚠️  NEVER commit .env files or real secrets to source control.
# ─────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ─── Auth & Security ──────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/codearena?schema=public
REDIS_URL=redis://localhost:6379

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3003,http://localhost:3000

# ─── Sandbox Execution ────────────────────────────────────────
SANDBOX_MODE=process          # docker | firecracker | process (dev only)
TRUST_PROXY=false
ALLOW_DEV_SOCIAL_AUTH=true    # set false in production

# ─── OAuth — Google ───────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── OAuth — GitHub ───────────────────────────────────────────
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ─── AI / LLM (Mock Interviewer & Hints) ─────────────────────
# Compatible with OpenAI, Anthropic, or any OpenAI-compatible API
AI_API_KEY=sk-your-ai-api-key-here
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ─── Cloud Object Storage (optional) ─────────────────────────
# AWS_S3_BUCKET=codearena-assets
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ─── Docker Sandbox (optional) ───────────────────────────────
# DOCKER_SANDBOX=true
# STRICT_SANDBOX=true
