// CodeArena — Full Platform Schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  DEVELOPER
  INTERVIEWER
  INSTRUCTOR
  ADMIN
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum ProblemStatus {
  Draft
  Review
  Published
  Archived
}

enum SubmissionStatus {
  Processing
  Success
  WrongAnswer
  TLE
  MLE
  RuntimeError
  CompileError
  Failure
}

enum ContestStatus {
  Upcoming
  Active
  Ended
}

enum CourseDifficulty {
  Beginner
  Intermediate
  Advanced
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  name            String
  email           String   @unique
  password        String
  role            Role     @default(STUDENT)
  avatar          String?
  bio             String?
  location        String?
  website         String?
  github          String?
  linkedin        String?
  contestRating   Int      @default(1200)
  xp              Int      @default(0)
  level           Int      @default(1)
  streak          Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  DateTime?
  isPublic        Boolean  @default(true)
  isSuspended     Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  emailVerifiedAt DateTime?
  tokenVersion    Int      @default(0)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  twoFactorBackupCodes String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions         Submissions[]
  posts               Posts[]
  comments            Comments[]
  contestParticipants ContestParticipant[]
  ratingHistory       RatingHistory[]
  userAchievements    UserAchievement[]
  snippets            Snippet[]
  notes               Note[]
  votes               Vote[]
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  problemLikes        ProblemLike[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  interviewsHosted    Interview[]          @relation("InterviewerUser")
  interviewSessions   InterviewParticipant[]
  interviewEvals      InterviewEvaluation[] @relation("EvaluatorUser")
  workspaces          Workspace[]
  projects            Project[]
  roadmapProgress     RoadmapProgress[]
  orgMemberships      OrganizationMember[]
  aiConversations     AIConversation[]
  aiUsages            AIUsage[]
  subscriptions       UserSubscription[]
  sdProjects          SDProject[]
  sdLessonProgress    SDLessonProgress[]

  @@index([username])
  @@index([email])
  @@index([contestRating])
}

// ─── PROBLEMS ─────────────────────────────────────────────────────────────────

model Problems {
  id           String        @id
  title        String
  slug         String        @default("")
  difficulty   Difficulty
  category     String
  tags         String[]      @default([])
  companies    String[]      @default([])
  description  String
  constraints  String?
  inputFormat  String?
  outputFormat String?
  hints        String[]      @default([])
  editorial    String?
  solutions    Json          @default("[]")
  templates    Json          // { js, py, cpp, java, go }
  testCases    Json          @default("[]") // Legacy embedded — prefer testCasesRel
  languages    String[]      @default([])   // Supported language keys
  timeLimit    Int           @default(5000) // ms
  memoryLimit  Int           @default(256)  // MB
  status       ProblemStatus @default(Draft)
  isPremium    Boolean       @default(false)
  order        Int           @default(0)
  version      Int           @default(1)
  authorId     String?
  solveCount   Int           @default(0)
  attemptCount Int           @default(0)
  likeCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  submissions     Submissions[]
  contestProblems ContestProblem[]
  testCasesRel    TestCases[]
  revisions       ProblemRevisions[]
  problemLikes    ProblemLike[]

  @@index([difficulty])
  @@index([category])
  @@index([status])
  @@index([slug])
}

// ─── PROBLEM LIKES ────────────────────────────────────────────────────────────

model ProblemLike {
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

// ─── TEST CASES ───────────────────────────────────────────────────────────────

model TestCases {
  id             String   @id @default(uuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  order          Int      @default(0)
  explanation    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  problem Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

// ─── PROBLEM REVISIONS ────────────────────────────────────────────────────────

model ProblemRevisions {
  id        String   @id @default(uuid())
  problemId String
  version   Int
  snapshot  Json     // Full problem state at this version
  authorId  String?
  message   String?  // Optional commit message / reason
  createdAt DateTime @default(now())

  problem Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, version])
  @@index([problemId])
}

// ─── SUBMISSIONS ──────────────────────────────────────────────────────────────

model Submissions {
  id              String           @id @default(uuid())
  problemId       String
  userId          String?
  code            String
  language        String
  status          SubmissionStatus @default(Processing)
  output          String?
  testResults     Json?
  runtime         Float?
  memory          Float?
  testCasesPassed Int              @default(0)
  testCasesTotal  Int              @default(0)
  errorMessage    String?
  isPublic        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  problem Problems  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([createdAt])
}

// ─── CONTESTS ─────────────────────────────────────────────────────────────────

model Contest {
  id          String        @id @default(uuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  status      ContestStatus @default(Upcoming)
  isPublic    Boolean       @default(true)
  createdById String
  createdAt   DateTime      @default(now())

  problems     ContestProblem[]
  participants ContestParticipant[]
  ratingHistory RatingHistory[]

  @@index([startTime])
  @@index([status])
}

model ContestProblem {
  contestId String
  problemId String
  order     Int    @default(0)
  points    Int    @default(100)

  contest Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([contestId, problemId])
}

model ContestParticipant {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  score     Int      @default(0)
  rank      Int?
  penalty   Int      @default(0)
  joinedAt  DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId])
}

// ─── RATING ───────────────────────────────────────────────────────────────────

model RatingHistory {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  change    Int
  contestId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── FORUM ────────────────────────────────────────────────────────────────────

model Posts {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  tags      String[] @default([])
  upvotes   Int      @default(0)
  views     Int      @default(0)
  isPinned  Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comments[]
  votes    Vote[]

  @@index([category])
  @@index([createdAt])
}

model Comments {
  id        String   @id @default(uuid())
  content   String
  upvotes   Int      @default(0)
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post  Posts @relation(fields: [postId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([postId])
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  value     Int      // +1 or -1
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Posts?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comments? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// ─── SNIPPETS ─────────────────────────────────────────────────────────────────

model Snippet {
  id        String   @id @default(uuid())
  title     String
  code      String
  language  String
  tags      String[] @default([])
  isPublic  Boolean  @default(true)
  userId    String
  forkCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([language])
}

// ─── NOTES ────────────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  tags      String[] @default([])
  isPublic  Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── LEARNING PLATFORM ────────────────────────────────────────────────────────

model Course {
  id             String           @id @default(uuid())
  slug           String           @unique
  title          String
  description    String
  longDesc       String
  icon           String           @default("📚")
  coverImage     String?
  difficulty     CourseDifficulty @default(Beginner)
  tags           String[]         @default([])
  estimatedHours Int              @default(10)
  xpReward       Int              @default(500)
  isPublished    Boolean          @default(true)
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([slug])
  @@index([difficulty])
}

model Lesson {
  id               String   @id @default(uuid())
  courseId         String
  title            String
  content          String   // Markdown content
  videoId          String? // YouTube video ID (11 chars)
  order            Int      @default(0)
  estimatedMinutes Int      @default(15)
  xpReward         Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz     Quiz?
  progress LessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@index([order])
}

model Quiz {
  id        String         @id @default(uuid())
  lessonId  String         @unique
  title     String
  xpReward  Int            @default(100)
  createdAt DateTime       @default(now())

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  order         Int      @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  userId    String
  answers   Int[]
  score     Int
  total     Int
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model Enrollment {
  id           String    @id @default(uuid())
  userId       String
  courseId     String
  progress     Float     @default(0)
  completedAt  DateTime?
  lastLessonId String?
  enrolledAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// ─── ACHIEVEMENTS ─────────────────────────────────────────────────────────────

model Achievement {
  id          String @id @default(uuid())
  name        String @unique
  description String
  icon        String
  xpReward    Int    @default(50)
  category    String @default("general")

  userAchievements UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

// ─── AUDIT & NOTIFICATIONS ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum NotificationType {
  achievement
  contest
  system
  forum
  submission
}

model Notification {
  id          String           @id @default(uuid())
  userId      String?
  isBroadcast Boolean          @default(false)
  title       String
  message     String
  type        NotificationType @default(system)
  read        Boolean          @default(false)
  link        String?
  createdAt   DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isBroadcast])
  @@index([createdAt])
}

model BackgroundJob {
  id          String   @id @default(uuid())
  queue       String
  type        String
  payload     Json
  status      String   @default("pending")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([queue, status])
  @@index([createdAt])
}

// ─── SESSIONS & TOKENS (PHASE A) ──────────────────────────────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  sessionId   String?
  familyId    String   @default(uuid())
  isUsed      Boolean  @default(false)
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
}

// ─── INTERVIEW PLATFORM (PHASE B) ─────────────────────────────────────────────

enum InterviewStatus {
  Scheduled
  InProgress
  Completed
  Cancelled
}

model Interview {
  id            String          @id @default(uuid())
  title         String
  interviewerId String
  status        InterviewStatus @default(Scheduled)
  scheduledAt   DateTime
  startedAt     DateTime?
  endedAt       DateTime?
  roomId        String          @unique @default(uuid())
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  interviewer   User            @relation("InterviewerUser", fields: [interviewerId], references: [id], onDelete: Cascade)
  participants  InterviewParticipant[]
  evaluations   InterviewEvaluation[]

  @@index([interviewerId])
  @@index([status])
}

model InterviewParticipant {
  id          String    @id @default(uuid())
  interviewId String
  userId      String
  role        String    @default("candidate") // "candidate" | "interviewer" | "observer"
  joinedAt    DateTime  @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
}

model InterviewEvaluation {
  id             String    @id @default(uuid())
  interviewId    String
  evaluatorId    String
  candidateId    String
  codingScore    Int       @default(0) // 1-10
  commScore      Int       @default(0) // 1-10
  problemSolving Int       @default(0) // 1-10
  feedback       String
  recommendation String    // "Strong Hire" | "Hire" | "No Hire" | "Strong No Hire"
  createdAt      DateTime  @default(now())

  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator      User      @relation("EvaluatorUser", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([candidateId])
}

// ─── WORKSPACE & COLLABORATION (PHASE B) ──────────────────────────────────────

model Workspace {
  id          String   @id @default(uuid())
  name        String
  userId      String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms       CollaborationRoom[]

  @@index([userId])
}

model CollaborationRoom {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  activeCode  String   @default("")
  language    String   @default("javascript")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whiteboardObjects WhiteboardObject[]

  @@index([workspaceId])
}

model WhiteboardObject {
  id          String   @id @default(uuid())
  roomId      String
  type        String   // "rectangle" | "circle" | "arrow" | "text" | "service" | "db"
  data        Json
  zIndex      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        CollaborationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

// ─── DEVELOPER PROJECTS & REPOSITORIES (PHASE B) ──────────────────────────────

model Project {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  template    String   @default("vanilla-js")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]

  @@index([userId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  path      String   // e.g. "src/index.js"
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

// ─── ROADMAP DOMAIN (PHASE B) ─────────────────────────────────────────────────

model Roadmap {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  description    String
  icon           String   @default("🗺️")
  estimatedWeeks Int      @default(8)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nodes          RoadmapNode[]
  progress       RoadmapProgress[]
}

model RoadmapNode {
  id          String   @id @default(uuid())
  roadmapId   String
  title       String
  week        String
  description String?
  order       Int      @default(0)
  topics      String[] @default([])
  problemIds  String[] @default([])

  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

model RoadmapProgress {
  id          String   @id @default(uuid())
  userId      String
  roadmapId   String
  completedNodeIds String[] @default([])
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

// ─── ORGANIZATIONS & TEAMS (PHASE B) ──────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]
  members     OrganizationMember[]
}

model Team {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrganizationMember {
  id          String   @id @default(uuid())
  orgId       String
  userId      String
  role        String   @default("member") // "owner" | "admin" | "member"
  joinedAt    DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ─── AI PLATFORM (PHASE B) ────────────────────────────────────────────────────

model AIConversation {
  id          String      @id @default(uuid())
  userId      String
  title       String      @default("New Chat")
  model       String      @default("codearena-ai-v1")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // "user" | "assistant" | "system"
  content        String
  tokensUsed     Int            @default(0)
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIUsage {
  id          String   @id @default(uuid())
  userId      String
  promptTokens Int
  compTokens  Int
  totalTokens Int
  costUsd     Float    @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── SUBSCRIPTIONS & BILLING (PHASE B) ────────────────────────────────────────

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   @unique // "Free" | "Pro" | "Enterprise"
  priceCents  Int      @default(0)
  interval    String   @default("month") // "month" | "year"
  features    String[] @default([])

  subscriptions UserSubscription[]
}

model UserSubscription {
  id          String   @id @default(uuid())
  userId      String
  planId      String
  status      String   @default("active") // "active" | "canceled" | "past_due"
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
}

// ─── SYSTEM DESIGN (PHASE C) ──────────────────────────────────────────────────

enum SDLevel {
  Beginner
  Intermediate
  Advanced
  Staff
}

model SDProject {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  templateId  String?
  ownerId     String
  isPublic    Boolean  @default(false)
  shareToken  String   @unique
  nodes       Json
  connections Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions SDProjectVersion[]

  @@index([ownerId])
  @@index([isPublic])
}

model SDProjectVersion {
  id            String   @id @default(uuid())
  projectId     String
  versionNumber Int
  message       String
  nodes         Json
  connections   Json
  createdAt     DateTime @default(now())

  project SDProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model SDSection {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  level       SDLevel
  icon        String   @default("📘")
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lessons SDLesson[]

  @@index([level])
  @@index([order])
}

model SDLesson {
  id            String   @id @default(uuid())
  sectionId     String
  slug          String
  title         String
  summary       String
  content       String   // Markdown lesson body
  keyConcepts   String[] @default([])
  checklist     String[] @default([])
  quiz          Json?    // [{ question, options[], correct, explanation }]
  resources     String[] @default([])
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  section  SDSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, slug])
  @@unique([sectionId, order])
  @@index([sectionId])
}

model SDLessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String    // Stable slug id: "<sectionSlug>/<lessonSlug>"
  completed   Boolean   @default(false)
  score       Int?      // Quiz score 0-100
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}